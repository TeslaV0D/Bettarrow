# ---------------------------------------------------------------------------
# Bettarrow configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# Login password (single user). Preferred: a scrypt hash created with
#   docker compose run --rm --no-deps web node scripts/hash-password.mjs
# or locally with `npm run hash-password`.
APP_PASSWORD_HASH=
# Alternative for quick setups (min. 8 characters). Ignored if APP_PASSWORD_HASH is set.
APP_PASSWORD=

# PostgreSQL (used by docker-compose.yml to create the database and by the app to connect).
POSTGRES_USER=bettarrow
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=bettarrow

# Only needed when running the app outside Docker (npm run dev):
# DATABASE_URL=postgres://bettarrow:bettarrow@localhost:5432/bettarrow

# Port on the host the web UI is published on.
APP_PORT=3000
# Bind address on the host. 0.0.0.0 = reachable in your LAN, 127.0.0.1 = only via local reverse proxy.
APP_BIND=0.0.0.0

# Initial time zone (can be changed in the profile settings later).
DEFAULT_TIMEZONE=Europe/Berlin

# Session lifetime in days (sliding).
SESSION_MAX_AGE_DAYS=30
# auto = secure cookies when served via https (X-Forwarded-Proto), true/false to force.
COOKIE_SECURE=auto

# Automatic JSON backups written by the app into ./backups (mounted volume).
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
