# ---------------------------------------------------------------------------
# Bettarrow configuration
#
# Docker Compose on the host: copy to `.env` (never commit it) and fill in the values.
# Portainer (Git stack):      do NOT commit a .env. Enter the variables in the stack's
#                             "Environment variables" section (or upload this file there via
#                             "Load variables from .env file" after filling it in locally).
#
# REQUIRED: POSTGRES_PASSWORD and APP_PASSWORD_HASH (or APP_PASSWORD).
# Everything else is optional; the defaults are shown.
# ---------------------------------------------------------------------------

# --- required --------------------------------------------------------------

# Database password (internal only, never exposed). Generate e.g. with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# Login password hash (single user). Create it with ONE of:
#   python3 scripts/hash-password.py                       (no Node.js needed)
#   docker exec -it bettarrow-web node scripts/hash-password.mjs   (inside the running app)
#   npm run hash-password                                  (development checkout)
# The value contains no "$", so it can be pasted into Portainer as is.
APP_PASSWORD_HASH=

# Alternative to the hash for a first test (plain text, min. 8 characters).
# Ignored when APP_PASSWORD_HASH is set. Prefer the hash.
APP_PASSWORD=

# --- optional --------------------------------------------------------------

# App image (published by GitHub Actions). `main` follows the latest version; pin a release for a
# rollback with the commit tag, e.g. BETTARROW_TAG=sha-1a2b3c4 (see GitHub → Packages → bettarrow).
BETTARROW_IMAGE=ghcr.io/teslav0d/bettarrow
BETTARROW_TAG=main
# always = check the registry for a newer image on every deploy (needed for the moving `main` tag).
BETTARROW_PULL_POLICY=always

# Host port of the web UI and bind address (0.0.0.0 = LAN, 127.0.0.1 = local reverse proxy only).
APP_PORT=3000
APP_BIND=0.0.0.0

# Initial time zone (changeable later in the profile settings).
DEFAULT_TIMEZONE=Europe/Berlin

# Database user / name (only change before the first deployment).
POSTGRES_USER=bettarrow
POSTGRES_DB=bettarrow

# Login session lifetime in days (sliding).
SESSION_MAX_AGE_DAYS=30

# auto = secure cookies when served via https (X-Forwarded-Proto), or force true/false.
COOKIE_SECURE=auto

# Automatic in-app JSON backups (0 disables) and how many to keep.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Where the in-app backups are stored. Default: Docker volume "bettarrow-backups".
# Set an ABSOLUTE host path to get the files directly on the host, e.g. /srv/bettarrow/backups
# (relative paths like ./backups do not work reliably with Portainer Git stacks).
# BACKUP_PATH=/srv/bettarrow/backups

# Only for running the app outside Docker (npm run dev / npm run db:migrate):
# DATABASE_URL=postgres://bettarrow:bettarrow@localhost:5432/bettarrow
